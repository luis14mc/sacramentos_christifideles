# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/christifideles"

# Para producción con Neon
# DATABASE_URL="postgresql://usuario:password@ep-host.neon.tech/christifideles"

# Configuración de autenticación Next.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="tu-clave-secreta-muy-larga-y-segura"

# Instalación inicial (opcional; si se define, POST /api/setup exige header x-setup-secret)
# SETUP_SECRET="genera-un-secreto-largo-aleatorio"

# Endpoints de depuración (OBLIGATORIO en producción: false o sin definir)
ENABLE_DEBUG_API=false

# Row Level Security en PostgreSQL (requiere docs/migracion_rls_v6.sql)
# Ver docs/RLS_ACTIVACION.md y docs/DEPLOYMENT_GUIDE.md
DATABASE_RLS_ENABLED=true# Vercel Blob (producción serverless — logos persistentes)
# BLOB_READ_WRITE_TOKEN=

# Upstash Redis (rate limit distribuido en login; opcional)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
