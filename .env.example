# ChristiFidelis - variables por entorno
# Mantener archivos .env fuera del control de versiones.

# PostgreSQL local.
DATABASE_URL="postgresql://usuario:password@localhost:5432/christifideles_local"
DIRECT_URL="postgresql://usuario:password@localhost:5432/christifideles_local"

# Neon: DATABASE_URL usa el endpoint pooled (-pooler). DIRECT_URL usa el endpoint
# directo (sin -pooler) para migraciones. SSL obligatorio en ambos.
# DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/ChristiFideles?sslmode=require"
# DIRECT_URL="postgresql://usuario:password@ep-xxxx.region.aws.neon.tech/ChristiFideles?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="reemplazar-por-secreto-largo-y-aleatorio"

# Setup inicial: mantener false salvo bootstrap controlado de una base vacía.
ALLOW_INITIAL_SETUP="false"

# Variables opcionales para seed/smoke de QA. No hardcodear credenciales reales.
QA_ADMIN_EMAIL="qa-admin@example.test"
QA_ADMIN_PASSWORD="reemplazar-en-entorno-qa"
BASE_URL="http://localhost:3000"

# VERCEL TESTING (ejemplo conceptual)
# DATABASE_URL="postgresql://...@...-pooler....neon.tech/christifideles_test?sslmode=require"
# NEXTAUTH_URL="https://tu-deployment.vercel.app"
# NEXTAUTH_SECRET="generar-un-secreto-largo-y-distinto"
# ALLOW_INITIAL_SETUP="false"
#
# Nota temporal de testing:
# mientras no exista prisma/migrations/, inicializar la BD Neon de prueba de forma
# controlada desde una máquina administrativa con `npx prisma db push` apuntando
# EXCLUSIVAMENTE a la base de testing. No usar este procedimiento para producción.
